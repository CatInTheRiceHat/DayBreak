DATABASE_PATH=./chrysalis.db
YOUTUBE_API_KEY=your-youtube-api-key
FEED_INGEST_SECRET=replace-with-a-long-random-secret
# Required in production for Intentional Break plan selection. Generate and
# store a dedicated backend-only secret; keep it stable for a running pilot.
INTENTIONAL_BREAK_PLAN_SEED_SECRET=
# Development only: add the active research policy response header and server log.
# Never enable this in a participant-facing production deployment.
# CHRYSALIS_RESEARCH_DEBUG=1
# Optional comma-separated override. Defaults are broad category=query buckets.
# YOUTUBE_FEED_QUERIES=news/current events=current events explained,gaming=gaming highlights

# Destructive PostgreSQL integration tests only. Never point this at the pilot
# database and never substitute DATABASE_URL. See docs/pilot/production-environment.md.
# TEST_POSTGRES_DATABASE_URL=
# ALLOW_POSTGRES_INTEGRATION_TESTS=1
# ALLOW_UNMARKED_POSTGRES_TEST_DATABASE=1
